{
    "kind": "collectionType",
    "collectionName": "work_items",
    "info": {
        "singularName": "work-item",
        "pluralName": "work-items",
        "displayName": "Work Item",
        "description": "Portfolio work/website items"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "companyName": {
            "type": "string",
            "required": true
        },
        "image": {
            "type": "media",
            "multiple": false,
            "required": true,
            "allowedTypes": [
                "images"
            ]
        },
        "reviewText": {
            "type": "richtext",
            "required": true
        },
        "stars": {
            "type": "integer",
            "required": true,
            "min": 1,
            "max": 5,
            "default": 5
        },
        "link": {
            "type": "string",
            "required": true
        },
        "featured": {
            "type": "boolean",
            "default": false
        },
        "order": {
            "type": "integer",
            "default": 0
        }
    }
}